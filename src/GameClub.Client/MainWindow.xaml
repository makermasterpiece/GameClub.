<Window x:Class="GameClub.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameClub Client"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True"
        Background="#090E19"
        Foreground="White">
    <Grid>
        <Border Width="760"
                Padding="64"
                Background="#111A2C"
                BorderBrush="#283854"
                BorderThickness="1"
                CornerRadius="28">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="GAME CLUB"
                           HorizontalAlignment="Center"
                           Foreground="#70B8FF"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock x:Name="StationNameText"
                           Margin="0,20,0,42"
                           HorizontalAlignment="Center"
                           Foreground="#9EB0C9"
                           FontSize="22" />
                <TextBlock x:Name="StateTitleText"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="42"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="StateMessageText"
                           Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Foreground="#AAB8CB"
                           FontSize="20"
                           TextWrapping="Wrap" />

                <StackPanel x:Name="LoginPanel"
                            Width="420"
                            Margin="0,36,0,0"
                            Visibility="Collapsed">
                    <TextBlock Margin="0,0,0,8" Foreground="#9EB0C9" Text="Логин" />
                    <TextBox x:Name="UsernameInput"
                             Height="48"
                             Padding="12,8"
                             MaxLength="32"
                             FontSize="20" />
                    <TextBlock Margin="0,20,0,8" Foreground="#9EB0C9" Text="Пароль" />
                    <PasswordBox x:Name="PasswordInput"
                                 Height="48"
                                 Padding="12,8"
                                 MaxLength="128"
                                 FontSize="20" />
                    <Button x:Name="LoginButton"
                            Height="58"
                            Margin="0,28,0,0"
                            Background="#2F80ED"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Content="ВОЙТИ"
                            Click="LoginButton_Click" />
                    <TextBlock x:Name="LoginStatusText"
                               MinHeight="24"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#FF9E9E"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="SessionPanel"
                            Width="500"
                            Margin="0,38,0,0"
                            Visibility="Collapsed">
                    <TextBlock x:Name="WelcomeText"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="30"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="GamingStatusText" Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#75D59B"
                               FontSize="22"
                               Text="Ожидание игровой сессии" />
                    <TextBlock x:Name="GamingTimerText"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#70B8FF"
                               FontFamily="Consolas"
                               FontSize="46"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="GamingElapsedText"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#9EB0C9"
                               FontSize="16"
                               Visibility="Collapsed" />
                    <Button x:Name="GamesButton" Height="58" Margin="0,24,0,0" Background="#2F80ED"
                            Foreground="White" FontSize="20" Content="ИГРЫ" Click="GamesButton_Click" Visibility="Collapsed" />
                    <TextBlock x:Name="GamesStatusText" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF9E9E" />
                    <Button x:Name="LogoutButton"
                            Width="240"
                            Height="58"
                            Margin="0,36,0,0"
                            HorizontalAlignment="Center"
                            Background="#34435B"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="20"
                            Content="Выйти"
                            Click="LogoutButton_Click" />
                    <TextBlock x:Name="LogoutStatusText"
                               MinHeight="24"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               Foreground="#FF9E9E"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
