{
  "ConnectionStrings": {
    "GameClubDb": "Host=localhost;Port=5432;Database=gameclub;Username=gameclub"
  },
  "Security": {
    "EnableDevelopmentAdminEndpoints": false,
    "EnableLegacyStationRegistration": false,
    "CommandSigningPrivateKeyPath": "",
    "CommandSigningCertificatePath": "",
    "DataProtectionKeysPath": "",
    "JwtIssuer": "gameclub-server"
  },
  "Club": {
    "TimeZoneId": "UTC",
    "AllowNegativeBalance": false,
    "OperatorCanPower": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
